rules_version = '2';

// Easy Chinese — Firestore security rules
// Each signed-in user can only read/write their OWN data under /users/{uid}
// (profile/progress document + "learned" and "backups" subcollections).
// Everything else is denied by default.
//
// Apply: Firebase Console → Firestore Database → Rules → paste this file → Publish
// (or: firebase deploy --only firestore:rules)
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /{subcollection}/{docId} {
        allow read, write: if isOwner(uid);
      }
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
